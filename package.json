{
  "name": "austin-student-management",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web \"node --env-file-if-exists=.env --watch server/index.ts\" \"vite\"",
    "seed": "node --env-file-if-exists=.env server/seed.ts",
    "check": "tsc --noEmit",
    "test": "node --test tests/*.test.ts",
    "build": "npm run check && vite build",
    "start": "node --env-file-if-exists=.env server/index.ts"
  },
  "dependencies": {
    "express": "^5.3.0",
    "luxon": "^3.7.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/luxon": "^3.7.6",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "concurrently": "^10.0.6",
    "typescript": "^7.0.2",
    "vite": "^8.3.6"
  }
}
